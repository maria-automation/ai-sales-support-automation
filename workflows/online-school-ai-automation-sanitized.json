    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst formattedDate = `${now.getDate().toString().padStart(2, '0')}.${(now.getMonth() + 1).toString().padStart(2, '0')}.${now.getFullYear()} ${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;\n\nconst aiResponse = $json.output; \nconst trigger = $('Telegram Trigger').item.json.message;\n\nlet history = [];\ntry {\n  const searchResults = $('Get row(s) in sheet').all();\n  history = searchResults.map(i => i.json).filter(j => j.date || j.user_id);\n} catch (e) { history = []; }\n\nconst count = history.length + 1;\nconst firstDate = (history.length > 0) ? (history[0].date || history[0].first_date || formattedDate) : formattedDate;\nconst username = trigger.from.username ? `@${trigger.from.username}` : \"не задан\";\nconst fullName = trigger.from.first_name || \"Клиент\";\n\ntry {\n  const parsed = typeof aiResponse === 'string' ? JSON.parse(aiResponse) : aiResponse;\n  const type = parsed?.type || 'other';\n  const leadScore = parsed?.lead_score || 'LOW';\n  const summary = parsed?.summary || (trigger.text ? trigger.text.substring(0, 50) : \"нет описания\");\n  const course = (parsed?.course && parsed.course !== \"null\") ? parsed.course : \"-\";\n  const aiReply = parsed?.reply || \"Спасибо, мы получили ваше сообщение!\";\n\n  let scoreEmoji = leadScore === 'HIGH' ? \"🔴 ГОРЯЧИЙ\" : leadScore === 'MEDIUM' ? \"🟡 ТЕПЛЫЙ\" : \"🟢 ХОЛОДНЫЙ\";\n\n  // Максимально простой текст без тегов и разметки\n  let ownerMessage = `ОТЧЕТ ПО ЛИДУ [${count > 2 ? 'WARM' : 'NEW'}]\\n`;\n  ownerMessage += `--------------------------\\n`;\n  ownerMessage += `Клиент: ${fullName} (${username})\\n`;\n  ownerMessage += `Тип: ${type} | Приоритет: ${scoreEmoji}\\n`;\n  ownerMessage += `Суть: ${summary}\\n`;\n  ownerMessage += `Курс: ${course}\\n`;\n  ownerMessage += `--------------------------\\n`;\n  ownerMessage += `История обращений: ${count}\\n`;\n  ownerMessage += `Первое касание: ${firstDate}`;\n\n  return {\n    date: formattedDate,\n    username: username,\n    course: course,\n    summary: summary,\n    type: type,\n    score: leadScore,\n    user_id: trigger.from.id.toString(),\n    first_date: firstDate,\n    total_requests: count,\n    status: 'NEW',\n    ownerMessage: ownerMessage,\n    replyText: aiReply,\n    chatId: trigger.chat.id\n  };\n} catch (e) {\n  return { \n    date: formattedDate,\n    ownerMessage: \"Ошибка анализа сообщения\", \n    chatId: trigger.chat.id,\n    user_id: trigger.from.id.toString()\n  };\n}\n"
      },
